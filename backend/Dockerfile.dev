# syntax=docker/dockerfile:1
# Microsoft already spent 40 minutes building this layer so you don't have to.
# Note: Ensure 'v1.58.0' exactly matches the playwright version in requirements.txt
FROM mcr.microsoft.com/playwright/python:v1.58.0-noble

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# 1. Install Python Dependencies
# Using Docker's BuildKit cache means subsequent pip installs take seconds
COPY requirements.txt .
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install -r requirements.txt

# 2. Copy Source Code Last
# Changes to your code will ONLY trigger this fast copy step, skipping pip entirely.
COPY . .

# 3. Security: Run as non-root
# The Microsoft image conveniently comes with a pre-configured non-root user called 'pwuser'
USER pwuser

CMD ["python", "main.py"]
